# --- Sanity (il CMS) -------------------------------------------------------
# Li trovi su https://sanity.io/manage dopo aver creato il progetto.
# Finché PROJECT_ID è vuoto il sito funziona con i contenuti di esempio
# e mostra un avviso in cima a ogni pagina.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Inventatelo (una riga di caratteri a caso) e incollalo identico
# nel webhook di Sanity. Serve a impedire che chiunque possa far
# rigenerare il sito a comando.
SANITY_REVALIDATE_SECRET=

# --- Anteprima -------------------------------------------------------------
# Finché questa NON vale esattamente "false" il sito è in modalità anteprima:
# noindex su tre livelli (meta, intestazione HTTP, robots.txt) e avviso in
# cima a ogni pagina. Il valore predefinito è l'anteprima, di proposito:
# una dimenticanza lascia il sito nascosto invece che esposto.
# NON metterla a false finché l'associazione non ha deciso.
NEXT_PUBLIC_SITO_ANTEPRIMA=true

# --- Indirizzo del sito ----------------------------------------------------
# Il dominio di anteprima Vercel. NON il dominio reale dell'associazione.
NEXT_PUBLIC_SITE_URL=https://rinogangemi-preview.vercel.app

# --- Modulo contatti -------------------------------------------------------
# Senza questi tre valori il modulo non spedisce e lo dice apertamente,
# invitando a telefonare: non fa finta di aver inviato.
# La chiave si ottiene su https://resend.com (piano gratuito).
RESEND_API_KEY=
CONTATTI_EMAIL_TO=
CONTATTI_EMAIL_FROM=sito@rinogangemiparkinson.org
